---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import ProductCard from '../components/ProductCard.astro';
import { formatDate } from '../utils/helpers.js';
import { getAuthor } from '../data/authors.js';
import { products } from '../data/products.js';
import { generateArticleSchema, generateBreadcrumbSchema } from '../utils/schema.js';

interface Props {
  post: any;
  popularPosts?: any[];
  relatedPosts?: any[];
}

const { post, popularPosts = [], relatedPosts = [] } = Astro.props;
const author = getAuthor(post.data.author);

// Resolve related products
const matchedProducts = products.filter(p => post.data.relatedProductSlugs.includes(p.slug));

// Generate JSON-LD
const articleSchema = generateArticleSchema(post);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: post.data.category, url: `/categories/${post.data.categorySlug}/` },
  { name: post.data.title, url: `/blog/${post.slug}/` }
]);

const combinedSchema = `[${articleSchema}, ${breadcrumbSchema}]`;
---

<BaseLayout
  title={`${post.data.title} — ModestyLoom`}
  description={post.data.description}
  image={post.data.featuredImage}
  type="article"
  schema={combinedSchema}
>
  <article class="container blog-article-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`/categories/${post.data.categorySlug}/`}>{post.data.category}</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{post.data.subcategory || 'Editorial'}</span>
    </nav>

    <!-- Article Header -->
    <header class="article-header">
      <span class="cat-badge gold" style="margin-bottom: 1rem;">
        {post.data.category}
      </span>
      <h1 class="article-title">
        {post.data.title}
      </h1>
      <p class="article-excerpt">
        {post.data.excerpt}
      </p>

      <div class="article-meta-row">
        <img src={author.avatar} alt={author.name} class="article-meta-avatar" width="50" height="50" />
        <div>
          <a href={`/authors/${author.slug}/`} class="article-meta-author">
            {author.name}
          </a>
          <div class="post-meta">
            <span>{author.role}</span>
            <span class="meta-sep"></span>
            <span>{formatDate(post.data.publishedDate)}</span>
            <span class="meta-sep"></span>
            <span>{post.data.readingTime}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Grid: Content + Sidebar -->
    <div class="content-sidebar-layout">
      <div class="article-main-col">
        <!-- Featured Image -->
        <div class="article-featured-image-wrap">
          <img src={post.data.featuredImage} alt={post.data.imageAlt} class="article-featured-img" width="900" height="520" fetchpriority="high" />
        </div>

        <!-- Markdown Body -->
        <div class="article-body-content">
          <slot />
        </div>

        <!-- Curated Products Box in Article -->
        {matchedProducts.length > 0 && (
          <div class="article-curated-box">
            <div class="article-curated-header">
              <h3 class="article-curated-title">
                Curated Pieces Featured In This Guide
              </h3>
              <span class="article-curated-badge">Verified Quality</span>
            </div>
            <div class="article-curated-grid">
              {matchedProducts.map((prod) => (
                <ProductCard product={prod} />
              ))}
            </div>
          </div>
        )}

        <!-- Author Bio Card Box -->
        <div class="article-author-card">
          <img src={author.avatar} alt={author.name} class="article-author-avatar" width="80" height="80" />
          <div class="article-author-info">
            <span class="article-author-label">Written By</span>
            <h4 class="article-author-name">
              <a href={`/authors/${author.slug}/`}>{author.name}</a>
            </h4>
            <p class="article-author-bio">
              {author.bio}
            </p>
          </div>
        </div>
      </div>

      <!-- Sticky Sidebar -->
      <div class="sidebar-wrapper">
        <Sidebar popularPosts={popularPosts} />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .article-body-content h2 {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 800;
    margin-top: 2.2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .article-body-content h3 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .article-body-content p {
    margin-bottom: 1.25rem;
  }
  .article-body-content ul, .article-body-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article-body-content li {
    margin-bottom: 0.5rem;
    list-style-type: square;
  }
  .article-body-content blockquote {
    border-left: 3px solid var(--accent-gold);
    padding: 1rem 1.5rem;
    background-color: var(--bg-surface);
    font-style: italic;
    font-size: 1.1rem;
    margin: 2rem 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
</style>
