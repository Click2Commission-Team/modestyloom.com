---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import ProductCard from '../components/ProductCard.astro';
import { formatDate } from '../utils/helpers.js';
import { getAuthor } from '../data/authors.js';
import { products } from '../data/products.js';
import { generateArticleSchema, generateBreadcrumbSchema } from '../utils/schema.js';

interface Props {
  post: any;
  popularPosts?: any[];
  relatedPosts?: any[];
}

const { post, popularPosts = [], relatedPosts = [] } = Astro.props;
const author = getAuthor(post.data.author);

// Resolve related products
const matchedProducts = products.filter(p => post.data.relatedProductSlugs.includes(p.slug));

// Generate JSON-LD
const articleSchema = generateArticleSchema(post);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: post.data.category, url: `/categories/${post.data.categorySlug}/` },
  { name: post.data.title, url: `/blog/${post.slug}/` }
]);

const combinedSchema = `[${articleSchema}, ${breadcrumbSchema}]`;
---

<BaseLayout
  title={`${post.data.title} — ModestyLoom`}
  description={post.data.description}
  image={post.data.featuredImage}
  type="article"
  schema={combinedSchema}
>
  <article class="container" style="padding-top: 2.5rem; padding-bottom: 4rem;">
    <!-- Breadcrumbs -->
    <nav style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">
      <a href="/" style="color: var(--text-primary);">Home</a>
      <span>/</span>
      <a href={`/categories/${post.data.categorySlug}/`} style="color: var(--text-primary);">{post.data.category}</a>
      <span>/</span>
      <span style="color: var(--accent-gold);">{post.data.subcategory || 'Editorial'}</span>
    </nav>

    <!-- Article Header -->
    <header style="max-width: 900px; margin-bottom: 2rem;">
      <span class="cat-badge gold" style="margin-bottom: 1rem;">
        {post.data.category}
      </span>
      <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 1.25rem; color: var(--text-primary);">
        {post.data.title}
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
        {post.data.excerpt}
      </p>

      <div style="display: flex; align-items: center; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-light);">
        <img src={author.avatar} alt={author.name} style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" width="50" height="50" />
        <div>
          <a href={`/authors/${author.slug}/`} style="font-weight: 700; color: var(--text-primary); font-size: 0.95rem;">
            {author.name}
          </a>
          <div class="post-meta" style="font-size: 0.8rem;">
            <span>{author.role}</span>
            <span class="meta-sep"></span>
            <span>{formatDate(post.data.publishedDate)}</span>
            <span class="meta-sep"></span>
            <span>{post.data.readingTime}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Grid: Content + Sidebar -->
    <div style="display: grid; grid-template-columns: 2.4fr 1fr; gap: 3.5rem;">
      <div>
        <!-- Featured Image -->
        <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 2.5rem; max-height: 520px;">
          <img src={post.data.featuredImage} alt={post.data.imageAlt} style="width: 100%; height: 100%; object-fit: cover;" width="900" height="520" fetchpriority="high" />
        </div>

        <!-- Markdown Body -->
        <div class="article-body-content" style="font-size: 1.05rem; line-height: 1.8; color: var(--text-primary);">
          <slot />
        </div>

        <!-- Curated Products Box in Article -->
        {matchedProducts.length > 0 && (
          <div style="margin-top: 3.5rem; padding: 2rem; background-color: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-sm);">
            <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: baseline;">
              <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; text-transform: uppercase;">
                Curated Pieces Featured In This Guide
              </h3>
              <span style="font-size: 0.8rem; color: var(--accent-gold); font-weight: 700; text-transform: uppercase;">Verified Quality</span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
              {matchedProducts.map((prod) => (
                <ProductCard product={prod} />
              ))}
            </div>
          </div>
        )}

        <!-- Author Bio Card Box -->
        <div style="margin-top: 3.5rem; padding: 2rem; background-color: var(--bg-primary); border: 1px solid var(--border-light); border-radius: var(--radius-sm); display: flex; gap: 1.5rem; align-items: center;">
          <img src={author.avatar} alt={author.name} style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" width="80" height="80" />
          <div>
            <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--accent-gold); letter-spacing: 0.08em;">Written By</span>
            <h4 style="font-family: var(--font-heading); font-size: 1.15rem; font-weight: 800; margin-bottom: 0.35rem;">
              <a href={`/authors/${author.slug}/`}>{author.name}</a>
            </h4>
            <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
              {author.bio}
            </p>
          </div>
        </div>
      </div>

      <!-- Sticky Sidebar -->
      <Sidebar popularPosts={popularPosts} />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .article-body-content h2 {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 800;
    margin-top: 2.2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .article-body-content h3 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .article-body-content p {
    margin-bottom: 1.25rem;
  }
  .article-body-content ul, .article-body-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article-body-content li {
    margin-bottom: 0.5rem;
    list-style-type: square;
  }
  .article-body-content blockquote {
    border-left: 3px solid var(--accent-gold);
    padding: 1rem 1.5rem;
    background-color: var(--bg-surface);
    font-style: italic;
    font-size: 1.1rem;
    margin: 2rem 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
</style>
