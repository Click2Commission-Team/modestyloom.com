---
import { siteConfig } from '../data/site.js';
import SearchModal from './SearchModal.astro';
import MobileMenu from './MobileMenu.astro';
import { navItems } from '../data/navigation.js';
---

<!-- Announcement & Running Promo Strip (Foxiz Style) -->
{siteConfig.announcement.enabled && (
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-ticker">
        <span class="ticker-tag">Curated Edit</span>
        <div class="marquee-wrapper">
          <div class="marquee-content">
            <span>{siteConfig.announcement.text}</span>
            <span>•</span>
            <span>{siteConfig.announcement.text}</span>
          </div>
        </div>
      </div>
      <div class="top-bar-links">
        <a href="/products/">Curated Picks</a>
        <a href="/about/">About Loom</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </div>
)}

<!-- Main Navigation Header -->
<header class="main-header" id="mainHeader">
  <div class="container header-inner">
    <!-- Mobile Menu Button -->
    <button class="mobile-menu-trigger" id="mobileMenuBtn" aria-label="Open Navigation Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>

    <!-- Distinctive Brand Logo -->
    <a href="/" class="modesty-logo-brand" aria-label="ModestyLoom Home">
      <img src={siteConfig.logo?.image || '/logo.png'} alt={siteConfig.name} class="modesty-logo-img" width="195" height="40" loading="eager" fetchpriority="high" />
    </a>

    <!-- Desktop Navigation Menu with Dropdowns -->
    <nav class="nav-menu" aria-label="Main Navigation">
      {navItems.map((item) => (
        item.subItems ? (
          <div class="nav-item-dropdown">
            <a href={item.href} class="nav-link">
              {item.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
            <div class="dropdown-menu">
              {item.subItems.map((sub) => (
                <a href={sub.href} class="dropdown-item">{sub.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class="nav-link">{item.label}</a>
        )
      ))}
    </nav>

    <!-- Header Actions (Search, Dark Mode, Shop CTA) -->
    <div class="header-actions">
      <!-- Search Button -->
      <button class="action-icon-btn" id="searchTriggerBtn" aria-label="Open Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Dark Mode Switch -->
      <button class="action-icon-btn" id="themeToggleBtn" aria-label="Toggle Dark Mode">
        <svg id="moonIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg id="sunIcon" style="display:none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Shop CTA Button -->
      <a href="/products/" class="btn-primary header-cta-btn" style="padding: 0.5rem 1.1rem; font-size: 0.78rem;">
        Discover
      </a>
    </div>
        Discover
      </a>
    </div>
  </div>
</header>

<!-- Search Modal -->
<SearchModal />

<!-- Mobile Menu Drawer -->
<MobileMenu />

<script>
  // Dark mode toggle functionality
  const themeToggle = document.getElementById('themeToggleBtn');
  const moonIcon = document.getElementById('moonIcon');
  const sunIcon = document.getElementById('sunIcon');
  const root = document.documentElement;

  function updateIcons(isDark) {
    if (moonIcon && sunIcon) {
      moonIcon.style.display = isDark ? 'none' : 'block';
      sunIcon.style.display = isDark ? 'block' : 'none';
    }
  }

  // Check saved or preferred theme
  const savedTheme = localStorage.getItem('modestyloom-theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
    root.setAttribute('data-theme', 'dark');
    updateIcons(true);
  } else {
    root.removeAttribute('data-theme');
    updateIcons(false);
  }

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = root.getAttribute('data-theme') === 'dark';
      if (isDark) {
        root.removeAttribute('data-theme');
        localStorage.setItem('modestyloom-theme', 'light');
        updateIcons(false);
      } else {
        root.setAttribute('data-theme', 'dark');
        localStorage.setItem('modestyloom-theme', 'dark');
        updateIcons(true);
      }
    });
  }

  // Header scroll shadow effect
  window.addEventListener('scroll', () => {
    const header = document.getElementById('mainHeader');
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
  });
</script>
