---
import { authors } from '../data/authors.js';
import { categories } from '../data/categories.js';
import ArticleCard from './ArticleCard.astro';

interface Props {
  popularPosts?: any[];
  showAuthor?: boolean;
}

const { popularPosts = [], showAuthor = true } = Astro.props;
---

<aside style="display: flex; flex-direction: column; gap: 2.5rem;">
  <!-- Meet the Editors Widget -->
  {showAuthor && (
    <div style="background-color: var(--bg-surface); padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
      <h4 style="font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem; border-bottom: 2px solid var(--accent-gold); padding-bottom: 0.5rem;">
        Editorial Voices
      </h4>
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        {authors.map((author) => (
          <div style="display: flex; gap: 1rem; align-items: center;">
            <img src={author.avatar} alt={author.name} style="width: 55px; height: 55px; border-radius: 50%; object-fit: cover;" width="55" height="55" />
            <div>
              <a href={`/authors/${author.slug}/`} style="font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; color: var(--text-primary);">
                {author.name}
              </a>
              <p style="font-size: 0.75rem; color: var(--text-muted); line-height: 1.3;">
                {author.role}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Trending / Popular Ranking Widget -->
  {popularPosts.length > 0 && (
    <div>
      <h4 style="font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem; border-bottom: 2px solid var(--text-primary); padding-bottom: 0.5rem;">
        Most Read
      </h4>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        {popularPosts.map((post, idx) => (
          <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <span style="font-family: var(--font-display); font-size: 1.6rem; font-weight: 900; color: var(--accent-gold); line-height: 1;">
              {`0${idx + 1}`}
            </span>
            <div>
              <h5 style="font-family: var(--font-heading); font-size: 0.9rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.25rem;">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h5>
              <span style="font-size: 0.75rem; color: var(--text-muted);">{post.data.readingTime}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Category Cloud Widget -->
  <div style="background-color: var(--bg-primary); padding: 1.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
    <h4 style="font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.25rem; border-bottom: 2px solid var(--accent-gold); padding-bottom: 0.5rem;">
      Explore Pillars
    </h4>
    <div style="display: flex; flex-direction: column; gap: 0.6rem;">
      {categories.map((cat) => (
        <a href={`/categories/${cat.slug}/`} style="display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 600; padding: 0.35rem 0; border-bottom: 1px solid var(--border-subtle); color: var(--text-primary);">
          <span>{cat.name}</span>
          <span style="font-size: 0.75rem; color: var(--accent-gold);">→</span>
        </a>
      ))}
    </div>
  </div>
</aside>
