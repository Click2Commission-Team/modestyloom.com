---
import { authors } from '../data/authors.js';
import { categories } from '../data/categories.js';
import ArticleCard from './ArticleCard.astro';

interface Props {
  popularPosts?: any[];
  showAuthor?: boolean;
}

const { popularPosts = [], showAuthor = true } = Astro.props;
---

<aside class="sidebar-aside">
  <!-- Meet the Editors Widget -->
  {showAuthor && (
    <div class="sidebar-widget sidebar-widget-surface">
      <h4 class="sidebar-widget-title gold-border">
        Editorial Voices
      </h4>
      <div class="sidebar-authors-list">
        {authors.map((author) => (
          <div class="sidebar-author-item">
            <img src={author.avatar} alt={author.name} class="sidebar-author-avatar" width="55" height="55" />
            <div class="sidebar-author-meta">
              <a href={`/authors/${author.slug}/`} class="sidebar-author-name">
                {author.name}
              </a>
              <p class="sidebar-author-role">
                {author.role}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Trending / Popular Ranking Widget -->
  {popularPosts.length > 0 && (
    <div class="sidebar-widget">
      <h4 class="sidebar-widget-title primary-border">
        Most Read
      </h4>
      <div class="sidebar-popular-list">
        {popularPosts.map((post, idx) => (
          <div class="sidebar-popular-item">
            <span class="sidebar-rank-num">
              {`0${idx + 1}`}
            </span>
            <div class="sidebar-popular-meta">
              <h5 class="sidebar-popular-title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h5>
              <span class="sidebar-popular-time">{post.data.readingTime}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Category Cloud Widget -->
  <div class="sidebar-widget sidebar-widget-card">
    <h4 class="sidebar-widget-title gold-border">
      Explore Pillars
    </h4>
    <div class="sidebar-categories-list">
      {categories.map((cat) => (
        <a href={`/categories/${cat.slug}/`} class="sidebar-category-link">
          <span>{cat.name}</span>
          <span class="sidebar-category-arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</aside>
