---
interface Props {
  product: any;
}

const { product } = Astro.props;
---

<div class="product-card">
  <a href={`/products/${product.slug}/`} class="product-image-wrap">
    <img src={product.image} alt={product.title} loading="lazy" width="300" height="240" />
  </a>

  <div class="product-info">
    <span class="product-brand">{product.brand}</span>
    <h4 class="product-title">
      <a href={`/products/${product.slug}/`}>{product.title}</a>
    </h4>
    <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
      {product.excerpt}
    </p>

    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 0.4rem;">
      <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Editorial Review</span>
      <div style="display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem; font-weight: 700; color: var(--accent-gold);">
        ★ {product.rating} <span style="font-weight: 400; color: var(--text-muted); font-size: 0.72rem;">({product.reviewsCount})</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 0.75rem;">
    <a href={`/products/${product.slug}/`} class="btn-secondary" style="display: block; width: 100%; text-align: center; padding: 0.55rem; font-size: 0.78rem;">
      Read Review & Specs →
    </a>
  </div>
</div>
