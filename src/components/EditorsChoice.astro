---
import ArticleCard from './ArticleCard.astro';

interface Props {
  posts: any[];
}

const { posts } = Astro.props;
---

<section style="padding: 3rem 0; background-color: var(--bg-surface);">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Editor's Choice</h2>
      <a href="/categories/shopping-guides/" class="section-tagline">Curated Reading →</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem;">
      {posts.map((post) => (
        <ArticleCard post={post} layout="overlay" />
      ))}
    </div>
  </div>
</section>
