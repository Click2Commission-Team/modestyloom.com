---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms & Conditions — ModestyLoom"
  description="Read the terms, copyright notices, and editorial guidelines governing the use of ModestyLoom."
>
  <div style="background-color: var(--bg-surface); padding: 3.5rem 0; border-bottom: 1px solid var(--border-light);">
    <div class="container" style="max-width: 800px;">
      <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; text-transform: uppercase; color: var(--text-primary); margin-bottom: 0.5rem;">
        Terms & Conditions
      </h1>
      <p style="font-size: 0.95rem; color: var(--text-secondary);">
        Last updated: March 2026
      </p>
    </div>
  </div>

  <div class="container" style="max-width: 800px; padding-top: 3.5rem; padding-bottom: 5rem; font-size: 1rem; line-height: 1.8;">
    <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">1. Acceptance of Terms</h2>
    <p style="margin-bottom: 1.5rem;">
      By accessing and reading ModestyLoom, you agree to comply with and be bound by the following terms of use. If you do not agree to these terms, please discontinue using this website.
    </p>

    <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">2. Intellectual Property Rights</h2>
    <p style="margin-bottom: 1.5rem;">
      All written editorial analyses, styling formulations, custom photography curation, and layout designs published on ModestyLoom are the intellectual property of ModestyLoom or licensed under appropriate commercial agreements. Unauthorized syndication or reproduction without attribution is strictly prohibited.
    </p>

    <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">3. Commercial Disclosures & Pricing Accuracy</h2>
    <p style="margin-bottom: 1.5rem;">
      Prices, fabric compositions, and product availability cited in our editorial reviews are verified at the time of publication but are subject to change by respective manufacturers and retailers. ModestyLoom does not guarantee external inventory or final retail transactions.
    </p>
  </div>
</BaseLayout>
