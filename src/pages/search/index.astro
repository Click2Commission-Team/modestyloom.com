---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Sidebar from '../../components/Sidebar.astro';

const allPosts = await getCollection('blogs');
const searchIndex = allPosts.map(p => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  categorySlug: p.data.categorySlug,
  author: p.data.author,
  featuredImage: p.data.featuredImage,
  imageAlt: p.data.imageAlt,
  excerpt: p.data.excerpt,
  publishedDate: p.data.publishedDate,
  readingTime: p.data.readingTime,
  tags: p.data.tags
}));
---

<BaseLayout
  title="Search Stories & Guides — ModestyLoom"
  description="Search the complete ModestyLoom fashion archive by title, theme, category, or garment type."
>
  <div style="background-color: var(--bg-surface); padding: 3.5rem 0; border-bottom: 1px solid var(--border-light);">
    <div class="container" style="max-width: 850px;">
      <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; text-transform: uppercase; color: var(--text-primary); margin-bottom: 1rem;">
        Search ModestyLoom
      </h1>
      <div>
        <input 
          type="search" 
          id="pageSearchInput" 
          placeholder="Search for trench coats, boots, capsule wardrobes, skincare..." 
          class="search-input-field"
        />
      </div>
      <div id="searchStats" style="margin-top: 1rem; font-size: 0.9rem; font-weight: 600; color: var(--accent-gold);"></div>
    </div>
  </div>

  <section class="container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <div id="resultsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
      <!-- Results will render here dynamically -->
    </div>
    <div id="emptyState" style="display: none; text-align: center; padding: 4rem 1rem;">
      <h3 style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem;">No stories found</h3>
      <p style="color: var(--text-secondary); max-width: 500px; margin: 0 auto 1.5rem;">We couldn't find matching articles for that query. Try broader keywords like "shoes", "trends", "dresses", or "wardrobe".</p>
      <a href="/blog/" class="btn-primary">Browse All Stories</a>
    </div>
  </section>

  <!-- Client-side Search Script -->
  <script define:vars={{ searchIndex }}>
    const input = document.getElementById('pageSearchInput');
    const grid = document.getElementById('resultsGrid');
    const emptyState = document.getElementById('emptyState');
    const stats = document.getElementById('searchStats');

    // Parse URL param
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';

    function renderPosts(posts) {
      if (!grid || !emptyState || !stats) return;
      if (posts.length === 0) {
        grid.innerHTML = '';
        emptyState.style.display = 'block';
        stats.innerText = 'Showing 0 matching articles';
        return;
      }
      emptyState.style.display = 'none';
      stats.innerText = `Found ${posts.length} matching editorial ${posts.length === 1 ? 'guide' : 'guides'}`;

      grid.innerHTML = posts.map(p => `
        <article class="card-hover card-elevation" style="background-color: var(--bg-primary); border: 1px solid var(--border-light); border-radius: var(--radius-sm); overflow: hidden; display: flex; flex-direction: column;">
          <a href="/blog/${p.slug}/" class="image-zoom-container" style="height: 220px; display: block;">
            <img src="${p.featuredImage}" alt="${p.imageAlt}" loading="lazy" width="400" height="260" />
          </a>
          <div style="padding: 1.25rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; justify-content: space-between;">
            <div>
              <a href="/categories/${p.categorySlug}/" class="cat-badge" style="font-size: 0.65rem; padding: 0.2rem 0.55rem; margin-bottom: 0.5rem;">
                ${p.category}
              </a>
              <h3 style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.4rem;">
                <a href="/blog/${p.slug}/" style="color: var(--text-primary);">
                  ${p.title}
                </a>
              </h3>
              <p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
                ${p.excerpt}
              </p>
            </div>
            <div class="post-meta" style="padding-top: 0.75rem; border-top: 1px solid var(--border-subtle);">
              <span class="meta-author">By ${p.author === 'shivam' ? 'Shivam' : 'Tanisha'}</span>
              <span class="meta-sep"></span>
              <span>${p.readingTime}</span>
            </div>
          </div>
        </article>
      `).join('');
    }

    function search(query) {
      if (!query.trim()) {
        renderPosts(searchIndex);
        return;
      }
      const q = query.toLowerCase();
      const filtered = searchIndex.filter(item => 
        item.title.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.excerpt.toLowerCase().includes(q) ||
        item.category.toLowerCase().includes(q) ||
        item.tags.some(t => t.toLowerCase().includes(q))
      );
      renderPosts(filtered);
    }

    if (input) {
      input.value = initialQuery;
      search(initialQuery);

      input.addEventListener('input', (e) => {
        search(e.target.value);
      });
    }
  </script>
</BaseLayout>
