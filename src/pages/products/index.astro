---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products.js';
---

<BaseLayout
  title="Curated Fashion & E-Commerce Discoveries — ModestyLoom"
  description="Explore vetted wardrobe staples, luxury bags, Goodyear-welted boots, and botanical skincare essentials verified by the ModestyLoom editorial team."
>
  <div style="background-color: var(--bg-surface); padding: 3.5rem 0; border-bottom: 1px solid var(--border-light);">
    <div class="container">
      <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; text-transform: uppercase; color: var(--text-primary); margin-bottom: 0.5rem;">
        Curated Shopping Discoveries
      </h1>
      <p style="font-size: 1.05rem; color: var(--text-secondary); max-width: 650px;">
        Every item featured below undergoes rigorous editorial evaluation for material integrity, durability, and stylistic versatility.
      </p>
    </div>
  </div>

  <section class="container" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
      {products.map((prod) => (
        <ProductCard product={prod} />
      ))}
    </div>
  </section>
</BaseLayout>
