---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products.js';
---

<BaseLayout
  title="Curated Fashion & E-Commerce Discoveries — ModestyLoom"
  description="Explore vetted wardrobe staples, luxury bags, Goodyear-welted boots, and botanical skincare essentials verified by the ModestyLoom editorial team."
>
  <div class="page-hero-banner">
    <div class="container">
      <h1 class="page-hero-title">
        Curated Shopping Discoveries
      </h1>
      <p class="page-hero-desc">
        Every item featured below undergoes rigorous editorial evaluation for material integrity, durability, and stylistic versatility.
      </p>
    </div>
  </div>

  <section class="container page-content-section" style="padding-top: 3.5rem; padding-bottom: 5rem;">
    <div class="products-grid">
      {products.map((prod) => (
        <ProductCard product={prod} />
      ))}
    </div>
  </section>
</BaseLayout>
