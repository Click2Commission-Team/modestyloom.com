---
import BaseLayout from '../layouts/BaseLayout.astro';
import { authors } from '../data/authors.js';
---

<BaseLayout
  title="About ModestyLoom — Modern Fashion & Curated Shopping Journal"
  description="Learn about ModestyLoom's editorial mission, our independent product testing standards, and our focus on modesty, elegance, and longevity."
>
  <div style="background-color: var(--bg-surface); padding: 4rem 0; border-bottom: 1px solid var(--border-light);">
    <div class="container" style="max-width: 800px; text-align: center;">
      <span class="cat-badge gold" style="margin-bottom: 1rem;">Our Philosophy</span>
      <h1 style="font-family: var(--font-heading); font-size: 2.8rem; font-weight: 800; color: var(--text-primary); margin-bottom: 1rem;">
        About ModestyLoom
      </h1>
      <p style="font-size: 1.2rem; color: var(--text-secondary); line-height: 1.6;">
        Bridging the elegance of high-fashion editorial journalism with the discernment of modern shopping discovery.
      </p>
    </div>
  </div>

  <div class="container" style="max-width: 850px; padding-top: 4rem; padding-bottom: 5rem; font-size: 1.05rem; line-height: 1.8;">
    <h2 style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 800; margin-bottom: 1rem;">The ModestyLoom Standard</h2>
    <p style="margin-bottom: 1.5rem;">
      Founded with an unwavering dedication to mindful elegance, **ModestyLoom** is an independent fashion publication designed for the modern individual who seeks sophisticated, graceful silhouettes without surrendering to fleeting, disposable micro-trends.
    </p>
    <p style="margin-bottom: 2rem;">
      We believe that true style does not demand excessive exposure or relentless consumer churn. Instead, it flourishes in intentional curation, thoughtful drapery, superior fabric choices, and versatile capsule wardrobes that deliver enduring dignity and quiet authority.
    </p>

    <h2 style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 800; margin-bottom: 1rem;">Editorial Integrity & Product Evaluation</h2>
    <p style="margin-bottom: 1.5rem;">
      In an era dominated by superficial influencer recommendations and synthetic fast-fashion hauls, ModestyLoom operates under rigorous journalistic ethics:
    </p>
    <ul style="padding-left: 1.5rem; margin-bottom: 2rem;">
      <li style="margin-bottom: 0.75rem;"><strong>Fabric Composition Transparency:</strong> We analyze fiber pedigrees, weave densities, and lining materials rather than surface styling alone.</li>
      <li style="margin-bottom: 0.75rem;"><strong>Unbiased Shopping Discovery:</strong> Products featured in our guides are selected based on construction integrity, repairability, and real-world versatility.</li>
      <li style="margin-bottom: 0.75rem;"><strong>No Fake Endorsements:</strong> We clearly distinguish between editorial research, verified material specifications, and hands-on testing.</li>
    </ul>

    <h2 style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 800; margin-bottom: 1.5rem;">Meet the Editorial Leadership</h2>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
      {authors.map((author) => (
        <div style="background-color: var(--bg-surface); padding: 1.75rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light); text-align: center;">
          <img src={author.avatar} alt={author.name} style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; margin: 0 auto 1rem;" width="100" height="100" />
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 0.25rem;">
            <a href={`/authors/${author.slug}/`}>{author.name}</a>
          </h3>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--accent-gold); text-transform: uppercase;">{author.role}</span>
          <p style="font-size: 0.88rem; color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.5;">
            {author.bio}
          </p>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
